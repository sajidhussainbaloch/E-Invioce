{
  "name": "invoice-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @invoice-bank/api",
    "dev:web": "npm run dev -w @invoice-bank/web",
